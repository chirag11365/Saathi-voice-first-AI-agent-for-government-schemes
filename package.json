{
  "name": "saathi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n client,server,portal -c cyan,green,yellow \"npm:dev:client\" \"npm:dev:server\" \"npm:dev:portal\"",
    "dev:client": "npm --prefix client run build && npm --prefix client run preview -- --host 0.0.0.0 --port 5173",
    "dev:server": "npm --prefix server run dev",
    "dev:portal": "npm --prefix mock-portal run dev",
    "test": "npm --prefix server test"
